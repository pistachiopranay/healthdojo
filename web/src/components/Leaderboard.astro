---
import type { Bench } from "../lib/data";
import { pct, f2 } from "../lib/fmt";
interface Props { bench: Bench; limit?: number; compact?: boolean }
const { bench, limit, compact = false } = Astro.props;
const rows = limit ? bench.rows.slice(0, limit) : bench.rows;
const cols = compact
  ? [["score", "Score"], ["recall", "Recall"], ["false_alarm", "False flags"], ["scenes_run", "Scenes run"]]
  : [["score", "Score"], ["recall", "Recall"], ["false_alarm", "False-flag rate"], ["precision", "Precision*"], ["loc_iou", "Loc IoU"], ["scenes_run", "Scenes run"]];
---
<div class="lbwrap not-content" data-bench-panel={compact ? undefined : bench.key}>
  <table class="lb" data-sortable={compact ? undefined : "1"}>
    <thead>
      <tr>
        <th class="l rk">#</th>
        <th class="l" data-k="name">Model</th>
        {cols.map(([k, l]) => <th data-k={k} class={k === "score" ? "sorted" : ""}>{l}</th>)}
      </tr>
    </thead>
    <tbody>
      {rows.map((r, i) => (
        <tr data-name={r.name} data-score={r.score} data-recall={r.recall} data-false_alarm={r.false_alarm}
            data-precision={r.precision ?? -1} data-loc_iou={r.loc_iou ?? -1} data-scenes_run={r.scenes_run}>
          <td class="l rk hd-num">{String(i + 1).padStart(2, "0")}</td>
          <td class="l">
            <span class="mname">{r.name}</span>
            {!compact && <span class="prov">{r.provider}</span>}
          </td>
          <td>
            <div class="scorecell"><div class="sbar"><i style={`width:${r.score * 100}%`}></i></div><b class="hd-num">{r.score.toFixed(2)}</b></div>
          </td>
          <td class="hd-num">{pct(r.recall)} <span class="hd-dim">{r.tp}/{r.tp + r.fn}</span></td>
          <td class="hd-num"><span class={r.false_alarm >= 0.25 ? "hd-miss" : ""}>{pct(r.false_alarm)}</span> <span class="hd-dim">{r.fp}/{r.neg}</span></td>
          {!compact && <td class="hd-num">{pct(r.precision)}</td>}
          {!compact && <td class="hd-num">{f2(r.loc_iou)}</td>}
          <td class="hd-num"><span class={r.scenes_run < bench.nScenes ? "partial" : ""}>{r.scenes_run}</span><span class="hd-dim">/{bench.nScenes}</span></td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .lbwrap { overflow-x: auto; border: 1px solid var(--hd-line); border-radius: var(--hd-radius); background: var(--hd-bg-1); }
  .lb { width: 100%; border-collapse: collapse; font: 400 14px/1.3 var(--hd-sans); color: var(--hd-fg); min-width: 560px; }
  .lb th {
    font: 500 11px/1 var(--hd-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--hd-fg-3);
    text-align: right; padding: 14px 16px; border-bottom: 1px solid var(--hd-line); white-space: nowrap; user-select: none;
  }
  .lb[data-sortable] th[data-k] { cursor: pointer; }
  .lb[data-sortable] th[data-k]:hover { color: var(--hd-fg); }
  .lb th.sorted { color: var(--hd-lime); }
  .lb th.sorted::after { content: " ↓"; }
  .lb th.sorted.asc::after { content: " ↑"; }
  .lb td { text-align: right; padding: 10px 16px; border-bottom: 1px solid var(--hd-line); white-space: nowrap; }
  .lb tr:last-child td { border-bottom: 0; }
  .lb tbody tr:hover td { background: #ffffff05; }
  .lb .l { text-align: left; }
  .lb .rk { color: var(--hd-fg-3); width: 36px; padding-right: 0; }
  .lb .mname { font-weight: 500; }
  .lb .prov { display: block; font: 400 11.5px/1.3 var(--hd-mono); color: var(--hd-fg-3); margin-top: 3px; }
  .lb .hd-dim { font-size: 12px; }
  .scorecell { display: inline-flex; align-items: center; gap: 10px; justify-content: flex-end; }
  .sbar { width: 90px; height: 4px; border-radius: 2px; background: #ffffff10; overflow: hidden; }
  .sbar i { display: block; height: 100%; background: var(--hd-fg-2); border-radius: 2px; }
  .lb tbody tr:first-child .sbar i { background: var(--hd-lime); box-shadow: 0 0 10px #d5fd5199; }
  .scorecell b { font-weight: 500; min-width: 34px; }
  @media (max-width: 640px) { .sbar { width: 44px; } .lb td, .lb th { padding: 10px 10px; } }
</style>

<script>
  document.querySelectorAll<HTMLTableElement>("table.lb[data-sortable]").forEach(tbl => {
    let key = "score", asc = false;
    tbl.querySelectorAll<HTMLTableCellElement>("th[data-k]").forEach(th => th.addEventListener("click", () => {
      const k = th.dataset.k!;
      if (k === key) asc = !asc; else { key = k; asc = k === "name" || k === "false_alarm"; }
      const body = tbl.tBodies[0];
      const rows = [...body.rows].sort((a, b) => {
        const x = a.dataset[key]!, y = b.dataset[key]!;
        const c = key === "name" ? x.localeCompare(y) : Number(x) - Number(y);
        return asc ? c : -c;
      });
      rows.forEach((r, i) => { r.cells[0].textContent = String(i + 1).padStart(2, "0"); body.appendChild(r); });
      tbl.querySelectorAll("th").forEach(h => h.classList.remove("sorted", "asc"));
      th.classList.add("sorted"); if (asc) th.classList.add("asc");
    }));
  });
</script>

---
const { active = "" } = Astro.props;
const links = [["Overview", "/"], ["Results", "/results/"], ["Method", "/method/"], ["Explore", "/explore/"]];
---
<header class="nav">
  <div class="in">
    <a class="logo" href="/"><span class="mark"></span>HealthDojo</a>
    <nav aria-label="Main">
      {links.map(([l, h]) => <a href={h} aria-current={active === l ? "page" : undefined}>{l}</a>)}
    </nav>
    <a class="gh" href="https://github.com/pistachiopranay/healthdojo" aria-label="GitHub repository">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1.1.9 2.2v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3"/></svg>
      <span>GitHub</span>
    </a>
  </div>
</header>
<style>
  .nav { position: sticky; top: 0; z-index: 50; background: #0a0a0bcc; backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--hd-line); }
  .in { max-width: 1200px; margin: 0 auto; height: 60px; padding: 0 24px; display: flex; align-items: center; gap: 28px; }
  .logo { display: inline-flex; align-items: center; gap: 10px; color: var(--hd-fg); text-decoration: none; font-weight: 600; font-size: 16px; letter-spacing: -.01em; }
  .mark { width: 10px; height: 10px; border-radius: 2px; background: var(--hd-lime); box-shadow: 0 0 14px #d5fd5188; }
  nav { display: flex; gap: 2px; }
  nav a { color: var(--hd-fg-2); text-decoration: none; font-size: 14px; font-weight: 500; padding: 7px 11px; border-radius: 7px; }
  nav a:hover { color: var(--hd-fg); background: #ffffff0a; }
  nav a[aria-current="page"] { color: var(--hd-fg); }
  .gh { margin-left: auto; display: inline-flex; align-items: center; gap: 8px; color: var(--hd-fg-2); text-decoration: none; font-size: 14px; font-weight: 500; padding: 7px 12px; border: 1px solid var(--hd-line); border-radius: 8px; }
  .gh:hover { color: var(--hd-fg); border-color: var(--hd-line-2); }
  @media (max-width: 720px) {
    .in { gap: 10px; padding: 0 14px; }
    .logo { font-size: 0; gap: 0; }
    .logo .mark { width: 12px; height: 12px; }
    nav a { padding: 7px 8px; font-size: 13.5px; }
    .gh span { display: none; }
    .gh { padding: 7px 9px; }
  }
</style>
